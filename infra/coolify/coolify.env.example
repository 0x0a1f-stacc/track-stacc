# PostgreSQL, consumed by postgres/api
POSTGRES_DB=trackstacc
POSTGRES_USER=trackstacc
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://trackstacc:change_me_strong_password@postgres:5432/trackstacc

# Redis, consumed by api
REDIS_URL=redis://redis:6379

# YouTube Data API v3 key, consumed only by api
YOUTUBE_API_KEY=your_server_side_key

# App secrets, consumed by api
SESSION_SECRET=generate_with_openssl_rand_base64_48
HOST_SECRET_SALT=generate_with_openssl_rand_base64_48

# Public browser URLs, consumed by web build
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WS_URL=https://api.example.com

# CORS origins, consumed by api
CORS_ORIGINS=https://trackstacc.example.com
