# ─────────────────────────────────────────────
# gen-prompts-trackstacc — environment config
# ─────────────────────────────────────────────
# Copy this file to your project root and fill in your values.
# Never commit this file (add .env.prompt to .gitignore).

# GitHub repo in owner/repo format (used by `gh issue view`)
GH_REPO=0x0a1f-stacc/track-stacc

# Absolute path to the repo root on your machine
PRIMARY_REPO_PATH=/home/gh0st/Projects/track-stacc

# The local coding agent you use (opencode / claude code / codex / etc.)
CODING_AGENT=opencode

# Directory where generated prompt files are saved (relative to where you run the script)
# Defaults to ./prompts if not set
OUTPUT_DIR=./prompts
