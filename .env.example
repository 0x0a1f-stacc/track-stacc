# Database
DATABASE_URL=postgresql://trackstacc:trackstacc@localhost:5432/trackstacc

# Redis
REDIS_URL=redis://localhost:6379

# YouTube
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Secrets (generate with: openssl rand -base64 48)
SESSION_SECRET=change_me_min_32_chars
HOST_SECRET_SALT=change_me_min_32_chars

# Argon2id params
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# App URLs (update for production)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# API
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Rate limits (override defaults if needed)
RATE_LIMIT_CHAT_MAX=5
RATE_LIMIT_CHAT_WINDOW_MS=10000
RATE_LIMIT_ADD_SONG_WINDOW_MS=30000
RATE_LIMIT_ADD_SONG_MAX=5
RATE_LIMIT_ROOM_CREATE_MAX=5
RATE_LIMIT_ROOM_CREATE_WINDOW_MS=3600000
RATE_LIMIT_NICKNAME_AUTH_MAX=5
RATE_LIMIT_NICKNAME_AUTH_WINDOW_MS=900000
